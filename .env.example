SECRET_KEY=replace-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=3600

# Database (default/local): sqlite
DB_ENGINE=sqlite


 #  "<<THE COMMENTS THAT ARE WRITTEN IN THIS FILE ARE FOR GUIDANCE PURPOSES ONLY.
#   PLEASE REVIEW AND ADJUST THEM BASED ON YOUR SPECIFIC PROJECT REQUIREMENTS AND ENVIRONMENT.>>"

# For SQLite, the database file will be created in the project root directory. You can specify a different location if desired.
DB_NAME=db.sqlite3

# Database configuration:
# For development, the default SQLite configuration is sufficient and requires no additional settings.
# For production, you can switch to PostgreSQL by uncommenting the relevant lines below and providing your database credentials.

# Option A (recommended production): one URL for PostgreSQL
# DATABASE_URL=postgresql://portfolio_user:your_password@127.0.0.1:5432/portfolio_db
# DB_SSL_REQUIRE=False

# If you choose to use DATABASE_URL, make sure to set it up correctly in your Django settings using 'dj-database-url' to parse the URL and configure the database connection.
# Note: If using DATABASE_URL, ensure you have the 'dj-database-url' package installed and configured in your Django settings to parse this URL correctly.
# Option B (manual PostgreSQL fields if you don't use DATABASE_URL)
# DB_ENGINE=postgresql
# DB_NAME=portfolio_db
# DB_USER=portfolio_user
# DB_PASSWORD=your_password
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_SSL_REQUIRE=False


# Caching (example using Redis)
CACHE_BACKEND=redis
CACHE_URL=redis://

# Celery (example using Redis as broker)
CELERY_BROKER_URL=redis://

#CELERY_RESULT_BACKEND=redis://
CELERY_ACCEPT_CONTENT=json
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_TIMEZONE=UTC

# Static and media files
STATIC_URL=/static/
MEDIA_URL=/media/
STATIC_ROOT=staticfiles
MEDIA_ROOT=mediafiles

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/portfolio_site.log    


# Email settings (example using Gmail SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# For Gmail, you may need to generate an app password if 2FA is enabled

#to run the development server, use:
# .\.venv\Scripts\python.exe -m uvicorn portfolio_site.asgi:application --reload
